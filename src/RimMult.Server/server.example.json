{
  // UDP port. Open/forward it on the router for players outside your LAN.
  "Port": 26480,
  // The shared world (planet, colonies, world time) is kept here between restarts.
  "WorldFile": "world.dat",
  // A dated copy of the world goes into BackupDirectory this often (0: never); the oldest beyond BackupsToKeep go.
  "BackupIntervalMinutes": 30,
  "BackupsToKeep": 48,
  "BackupDirectory": "backups",
  "Server": {
    "Name": "RimMult server",
    "MaxPlayers": 10,
    "Password": null,
    // null = the first player to join defines the RimWorld version and mod list.
    "GameVersion": null,
    "ModListHash": null,
    "TickGrantIntervalSeconds": 0.05,
    // Players may declare war on each other and raid each other's colonies.
    "AllowPvp": true,
    // SteamIDs kept out, and SteamIDs allowed to use admin commands in chat ("/help"). Console commands: type help.
    "Banned": [],
    "Admins": [],
    "Time": {
      // Lowest | Majority | Host
      "VoteMode": "Lowest",
      "AnyoneCanPause": true,
      // Normal | Fast | Superfast | Ultrafast
      "MaxSpeed": "Superfast",
      "MaxDriftTicks": 60,
      // Allowed lead in real seconds; scales with speed so fast speeds don't stutter.
      "MaxDriftSeconds": 1.5
    }
  }
}
