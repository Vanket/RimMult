    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RimMult.Server</RootNamespace>
    <AssemblyName>RimMult.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimMult.ServerCore\RimMult.ServerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="server.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
