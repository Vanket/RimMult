<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game reference assemblies (compile only, never shipped). -->
    <PackageVersion Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <!-- Provided at runtime by the "Harmony" mod (brrainz.harmony). -->
    <PackageVersion Include="Lib.Harmony" Version="2.4.2" />
    <!-- 1.3.x is the last line with a netstandard2.0 build, which the net472 mod needs too;
         client and server must use the same version. -->
    <PackageVersion Include="LiteNetLib" Version="1.3.5" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- tools/WorkshopUpload only. Must match the steam_api64.dll RimWorld ships (Steamworks SDK 1.53a,
         STEAMUGC_INTERFACE_VERSION016): newer wrappers call entry points that DLL doesn't have. -->
    <PackageVersion Include="Steamworks.NET" Version="20.1.0" />
  </ItemGroup>
</Project>
